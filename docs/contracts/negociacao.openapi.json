      "post": {
        "tags": [
          "negociacao"
        ],
        "summary": "Fechar Processo",
        "operationId": "fechar_processo_processos__processo_id__fechar_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "processo_id",
