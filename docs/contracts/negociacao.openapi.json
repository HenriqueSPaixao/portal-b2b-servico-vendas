  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LanceInput": {
        "properties": {
          "valor_unitario": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Valor Unitario"
          },
          "quantidade": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Quantidade"
          },
          "empresa_id_override": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Empresa Id Override"
          }
        },
        "type": "object",
        "required": [
          "valor_unitario",
          "quantidade"
        ],
        "title": "LanceInput"
      },
      "LanceOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "processo_id": {
            "type": "string",
            "format": "uuid",
            "title": "Processo Id"
          },
          "empresa_id": {
            "type": "string",
            "format": "uuid",
            "title": "Empresa Id"
          },
          "valor_unitario": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Valor Unitario"
          },
          "quantidade": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Quantidade"
          },
          "data_lance": {
            "type": "string",
            "format": "date-time",
            "title": "Data Lance"
          }
        },
        "type": "object",
        "required": [
          "id",
          "processo_id",
          "empresa_id",
          "valor_unitario",
          "quantidade",
          "data_lance"
        ],
        "title": "LanceOut"
      },
