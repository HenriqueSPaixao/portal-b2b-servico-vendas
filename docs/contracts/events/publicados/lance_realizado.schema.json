{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal-b2b/contracts/events/publicados/lance_realizado.schema.json",
  "title": "lance_realizado",
  "description": "Publicado por negociacao-service em cada POST /processos/{id}/lances aceito (rota interna; externamente /api/negociacoes/processos/{id}/lances via gateway). Útil para Eq.4/dashboards externos verem lances em tempo real.",
  "allOf": [{"$ref": "../envelope.schema.json"}],
  "properties": {
    "eventType": {"const": "lance_realizado"},
    "source":    {"const": "negociacao-service"},
    "payload": {
      "type": "object",
      "required": ["lance_id", "processo_id", "empresa_id", "valor_unitario", "quantidade", "data_lance"],
      "properties": {
        "lance_id":       {"type": "string", "format": "uuid"},
        "processo_id":    {"type": "string", "format": "uuid"},
        "empresa_id":     {"type": "string", "format": "uuid"},
        "valor_unitario": {"type": "string", "description": "Decimal como string."},
        "quantidade":     {"type": "string", "description": "Decimal como string."},
        "data_lance":     {"type": "string", "format": "date-time"}
      }
    }
  }
}
